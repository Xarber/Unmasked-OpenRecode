FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --ignore-scripts
COPY apps/mobile apps/mobile
COPY packages/contracts packages/contracts
COPY scripts scripts
COPY assets/branding/icon-master.svg assets/branding/icon-master.svg
COPY docs/reports/unmasked-chat-desktop.png docs/reports/unmasked-chat-desktop.png
COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY LICENSES LICENSES
COPY tsconfig.base.json .
ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
RUN test -n "$EXPO_PUBLIC_API_URL" && npm run build:web
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/mobile/dist /usr/share/nginx/html
EXPOSE 8080
