{
  "name": "unmasked",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:api": "npm run dev -w @unmasked/api",
    "web": "node scripts/run.mjs web",
    "mobile": "node scripts/run.mjs mobile",
    "test": "tsx --test apps/api/tests/*.test.ts packages/contracts/src/*.test.ts",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "db:migrate": "tsx --env-file=.env apps/api/src/migrate.ts",
    "seed": "tsx --env-file=.env apps/api/src/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "node scripts/serve-web.mjs",
    "worker": "tsx --env-file=.env apps/api/src/worker.ts",
    "branding": "node scripts/branding.mjs",
    "licenses": "node scripts/licenses.mjs",
    "dev:services": "concurrently -k -n api,app 'npm run dev -w @unmasked/api' 'npm run web -w @unmasked/mobile'",
    "uads:validate": "node scripts/validate-uads.mjs",
    "xcenter:check-storage": "tsx --env-file-if-exists=.env apps/api/src/check-xcenter-storage.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
