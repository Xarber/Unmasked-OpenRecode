NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Leave empty for persistent embedded PostgreSQL in .data/unmasked (development only).
DATABASE_URL=
DATA_DIR=.data/unmasked
WEB_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3001
# Production requires PostgreSQL, HTTPS origin and SMTP. No credentials are bundled.
SMTP_URL=
MAIL_FROM=Unmasked <noreply@example.invalid>
# Compose/self-hosting only; generate these yourself, do not use example credentials.
# POSTGRES_PASSWORD=
# BUILD_COMMIT=
# MINIO_ROOT_PASSWORD=
